{
  "name": "tweet-archive",
  "version": "1.0.0",
  "description": "Auto-archive tweets to self-hosted HTML pages",
  "main": "dist/index.js",
  "scripts": {
    "test": "NODE_ENV=test TS_NODE_TRANSPILE_ONLY=true node --test --require ts-node/register src/services/*.test.ts",
    "build": "tsc",
    "postbuild": "cp node_modules/highlight.js/styles/github.css public/highlight.css && cp node_modules/highlight.js/styles/github-dark.css public/highlight-dark.css",
    "start": "node dist/index.js",
    "dev": "TS_NODE_TRANSPILE_ONLY=true ts-node src/index.ts",
    "migrate:search": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/migrate-search.ts",
    "migrate:cos": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/migrate-media-to-cos.ts",
    "repair:videos": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/repair-twitter-videos.ts",
    "translate:es": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/translate-spanish-articles.ts",
    "translate:foreign": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/translate-foreign-articles.ts",
    "migrate:opinions": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/migrate-opinions.ts",
    "migrate:hidden": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/hide-referenced-articles.ts",
    "migrate:lightbox": "node scripts/migrate-lightbox-zoom.js",
    "setup": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^9.0.0",
    "marked": "^18.0.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/turndown": "^5.0.6",
    "playwright": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
